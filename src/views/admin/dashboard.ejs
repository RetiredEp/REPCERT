<!DOCTYPE html>
<html lang="en">
<head>
    <title>Admin Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }
        .container {
            width: 50%;
            margin: auto;
        }
        h1 {
            margin-bottom: 20px;
        }
        .dashboard-buttons {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .dashboard-buttons a {
            display: block;
            width: 250px;
            padding: 15px;
            margin: 10px;
            text-decoration: none;
            color: white;
            font-size: 18px;
            border-radius: 5px;
            text-align: center;
        }
        .pending { background-color: #e67e22; }
        .approved { background-color: #2ecc71; }
        .rejected { background-color: #e74c3c; }
    </style>
</head>
<body>
    <div class="container">
        <% if (locals.flash && flash.error) { %>
            <div class="flash-error"><%= flash.error.join(', ') %></div>
        <% } %>
        <% if (locals.flash && flash.success) { %>
            <div class="flash-success"><%= flash.success.join(', ') %></div>
        <% } %>
        
        <h1>Welcome, Admin!</h1>
        <p>Email: <%= locals.email %></p>

        <div class="dashboard-buttons">
            <a href="/admin/pending-approvals" class="pending">View Pending Requests</a>
            <a href="/admin/approved-certificates" class="approved">View Approved Requests</a>
            <a href="/admin/rejected-certificates" class="rejected">View Rejected Requests</a>
        </div>
    </div>
</body>
</html> 