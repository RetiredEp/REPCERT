<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pending Requests</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }
        .container {
            width: 80%;
            margin: auto;
            padding: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 10px;
            border: 1px solid #ddd;
        }
        th {
            background-color: #e67e22;
            color: white;
        }
        .action-buttons button {
            margin: 5px;
            padding: 8px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .approve { background-color: #2ecc71; color: white; }
        .reject { background-color: #e74c3c; color: white; }
        #loadingMessage {
            color: #3498db;
            font-weight: bold;
            margin-top: 20px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Pending Certificate Requests</h2>
        <% if (pendingApprovals.length > 0) { %>
            <table>
                <tr>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Course</th>
                    <th>Certificate</th>
                    <th>Actions</th>
                </tr>
                <% pendingApprovals.forEach(request => { %>
                    <tr>
                        <td><%= request.student_name %></td>
                        <td><%= request.student_id %></td>
                        <td><%= request.course %></td>
                        <td>
                            <a href="https://ipfs.io/ipfs/<%= request.certificate_cid %>" target="_blank">
                                View Certificate
                            </a>
                        </td>
                        <td class="action-buttons">
                            <button onclick="handleAction('approve', '<%= request.id %>', this)" class="approve">Approve</button>
                            <button onclick="handleAction('reject', '<%= request.id %>', this)" class="reject">Reject</button>
                        </td>
                    </tr>
                <% }); %>
            </table>
            <div id="loadingMessage">Processing request, please wait...</div>
        <% } else { %>
            <p>No pending requests found.</p>
        <% } %>
    </div>

    <script>
        async function handleAction(action, requestId, btn) {
            console.log(`Button clicked: ${action} for request ${requestId}`);
            // Disable both buttons in the same row
            let row = btn.parentElement.parentElement;
            let buttons = row.querySelectorAll("button");
            buttons.forEach(b => b.disabled = true);

            // Show the loading message
            const loadingEl = document.getElementById('loadingMessage');
            loadingEl.style.display = 'block';

            try {
                const url = `/admin/${action}-request/${requestId}`;
                console.log(`Sending POST to: ${url}`);
                const response = await fetch(url, { method: 'POST' });
                if (response.ok) {
                    console.log(`Request ${action} for ${requestId} succeeded.`);
                    window.location.reload();
                } else {
                    console.error(`Request ${action} for ${requestId} failed with status: ${response.status}`);
                    alert(`Failed to ${action} the request.`);
                    buttons.forEach(b => b.disabled = false);
                    loadingEl.style.display = 'none';
                }
            } catch (error) {
                console.error(`Error during ${action} for ${requestId}:`, error);
                alert(`Error ${action}ing the request.`);
                buttons.forEach(b => b.disabled = false);
                loadingEl.style.display = 'none';
            }
        }
    </script>
</body>
</html>
