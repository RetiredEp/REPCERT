<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Rejected Certificates</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #f5f5f5;
        }
        tr:hover {
            background-color: #f9f9f9;
        }
        .empty-message {
            text-align: center;
            padding: 20px;
            color: #666;
        }
        .certificate-link {
            color: #2ecc71;
            text-decoration: none;
        }
        .certificate-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Rejected Certificates</h2>
        
        <% if (rejectedCertificates && rejectedCertificates.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Student Name</th>
                        <th>Student ID</th>
                        <th>Course</th>
                        <th>Certificate</th>
                        <th>Rejection Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% rejectedCertificates.forEach(cert => { %>
                        <tr>
                            <td><%= cert.id %></td>
                            <td><%= cert.student_name %></td>
                            <td><%= cert.student_id %></td>
                            <td><%= cert.course %></td>
                            <td>
                                <a href="https://ipfs.io/ipfs/<%= cert.certificate_cid %>" 
                                   target="_blank"
                                   class="certificate-link">
                                    View Certificate
                                </a>
                            </td>
                            <td><%= new Date(cert.created_at).toLocaleString() %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-message">
                <p>No rejected certificates found.</p>
            </div>
        <% } %>
    </div>
</body>
</html>