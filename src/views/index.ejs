<!DOCTYPE html>
<html lang="en">
<head>
    <title>Certificate Management System</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }
        .container {
            width: 50%;
            margin: auto;
        }
        h1 {
            margin-bottom: 20px;
        }
        .role-buttons {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .role-buttons a {
            display: block;
            width: 200px;
            padding: 15px;
            margin: 10px;
            text-decoration: none;
            color: white;
            font-size: 18px;
            border-radius: 5px;
            text-align: center;
        }
        .student { background-color: #3498db; }
        .admin { background-color: #e67e22; }
        .verifier { background-color: #2ecc71; }
    </style>
</head>
<body>

    <div class="container">
        <h1>Welcome to the Certificate Management System</h1>
        <p>Select your role:</p>
        
        <div class="role-buttons">
            <a href="/student/" class="student">Student</a>
            <a href="/admin/pending-approvals" class="admin">University Admin</a>
            <a href="/verifier/verify" class="verifier">Verifier</a>
        </div>
    </div>

</body>
</html>
