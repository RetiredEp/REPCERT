<!DOCTYPE html>
<html lang="en">
<head>
    <title>Student Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }
        .container {
            width: 50%;
            margin: auto;
        }
        h1 {
            margin-bottom: 20px;
        }
        .dashboard-buttons {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .dashboard-buttons a {
            display: block;
            width: 250px;
            padding: 15px;
            margin: 10px;
            text-decoration: none;
            color: white;
            font-size: 18px;
            border-radius: 5px;
            text-align: center;
        }
        .submit { background-color: #3498db; }
        .status { background-color: #e67e22; }
        .approved { background-color: #2ecc71; }
    </style>
</head>
<body>

    <div class="container">
         <!-- Display flash messages -->
         <% if (locals.flash && flash.error) { %>
            <div class="flash-error"><%= flash.error.join(', ') %></div>
        <% } %>
        <% if (locals.flash && flash.success) { %>
            <div class="flash-success"><%= flash.success.join(', ') %></div>
        <% } %>
        <h1>Welcome to the Student Dashboard</h1>
        <p>Select an action:</p>
        
        <div class="dashboard-buttons">
            <a href="/student/submit" class="submit">Submit Certificate</a>
            <a href="/student/request-status/123" class="status">Check Request Status</a>
            <a href="/student/approved-certificates/123" class="approved">View Approved Certificates</a>
        </div>
    </div>

</body>
</html>
